[
  {
    "id": "cross.setup_failed_go_to_troubleshooting",
    "active": true,
    "description": "Nach Setup wird bei weiterhin bestehendem Problem in Troubleshooting gewechselt.",
    "when": {
      "all": [
        {
          "fact": "intent",
          "operator": "equals",
          "value": "setup"
        },
        {
          "fact": "setup_completed",
          "operator": "equals",
          "value": true
        },
        {
          "fact": "user_problem_resolved",
          "operator": "equals",
          "value": false
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Dann war die Einrichtung noch nicht erfolgreich. Wir wechseln jetzt in die Problembehebung für dasselbe Thema."
      },
      {
        "type": "set_fact",
        "fact": "intent",
        "value": "troubleshooting"
      },
      {
        "type": "set_fact",
        "fact": "problem_unresolved",
        "value": true
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "cross.password_changed_affects_services",
    "active": true,
    "description": "Passwortänderung kann gespeicherte Zugangsdaten betreffen.",
    "when": {
      "all": [
        {
          "fact": "password_recently_changed",
          "operator": "equals",
          "value": true
        }
      ],
      "any": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "eduroam"
        },
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        },
        {
          "fact": "topic",
          "operator": "equals",
          "value": "user_account"
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Nach einer Passwortänderung müssen gespeicherte Passwörter in Diensten wie eduroam, E-Mail-Programmen, Browsern oder Netzlaufwerken ggf. aktualisiert oder gelöscht werden."
      }
    ],
    "stop_after_match": false
  },
  {
    "id": "cross.eduroam_connected_but_vpn_needed",
    "active": true,
    "description": "eduroam verbunden, aber gewünschter Dienst benötigt VPN.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "eduroam"
        },
        {
          "fact": "eduroam_connected",
          "operator": "equals",
          "value": true
        },
        {
          "fact": "vpn_needed",
          "operator": "equals",
          "value": true
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "eduroam stellt die WLAN-Verbindung her. Für manche Hohenheimer Dienste kann zusätzlich VPN nötig sein."
      },
      {
        "type": "redirect_topic",
        "topic": "vpn",
        "intent": "setup",
        "text": "Starte den VPN-Client oder richte VPN ein."
      }
    ],
    "stop_after_match": true
  }
]