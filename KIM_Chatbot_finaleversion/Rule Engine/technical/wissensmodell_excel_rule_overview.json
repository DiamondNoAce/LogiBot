      "Next Success": "mfa_check_enrollment",
      "Next Failure": null,
      "Notiz": "MFA nur für VPN verpflichtend."
    },
    {
      "Prio": 35,
      "Regel-ID": "mfa_check_enrollment",
      "Anzeigename": "MFA-Einrichtung prüfen",
      "Namespace": "service.mfa",
      "Regeltyp": "precondition_rule",
      "Status": "aktiv",
      "Pre-Conditions": "account_exists eq true; username_known eq true; password_known eq true",
      "Trigger-Conditions": "mfa_enrolled in false, unknown",
      "Action / Funktion": "mfa_setup_authenticator",
      "Action Anzeigename": "Authenticator-App einrichten",
      "Post-Conditions Success": "mfa_enrolled eq true; mfa_totp_available eq true",
      "Post-Conditions Failure": "needs_human_support maybe true",
      "Next Success": "mfa_check_totp_code",
      "Next Failure": "support_escalate",
      "Notiz": "MFA-Erstinstallation benötigt Account und Zugangsdaten."
    },
    {
      "Prio": 38,
      "Regel-ID": "mfa_check_totp_code",
      "Anzeigename": "30-Sekunden-Code prüfen",
      "Namespace": "service.mfa",
      "Regeltyp": "auth_rule",
      "Status": "aktiv",
      "Pre-Conditions": "mfa_enrolled eq true; mfa_totp_available eq true",
      "Trigger-Conditions": "mfa_code_status in not_tested, invalid, expired",
      "Action / Funktion": "mfa_validate_totp_code",
      "Action Anzeigename": "30-Sekunden-Code prüfen",
      "Post-Conditions Success": "mfa_code_status eq valid",
      "Post-Conditions Failure": "mfa_code_status eq invalid/expired",
      "Next Success": "vpn_authenticate",
      "Next Failure": "mfa_troubleshoot_code",
      "Notiz": "Kein Push; Code ändert sich alle 30 Sekunden."
    },
