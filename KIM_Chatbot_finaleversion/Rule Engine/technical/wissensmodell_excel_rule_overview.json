      "Next Success": "core_check_account_exists",
      "Next Failure": "support_escalate",
      "Notiz": "Gäste ohne Zugang nicht in normalen Setup-Fluss schicken."
    },
    {
      "Prio": 15,
      "Regel-ID": "core_check_account_exists",
      "Anzeigename": "Uni-Account vorhanden und aktiv?",
      "Namespace": "core",
      "Regeltyp": "precondition_rule",
      "Status": "aktiv",
      "Pre-Conditions": "service in eduroam, vpn, mfa",
      "Trigger-Conditions": "account_exists in false, unknown; account_active in false, unknown",
      "Action / Funktion": "core_account_check",
      "Action Anzeigename": "Uni-Account prüfen",
      "Post-Conditions Success": "account_exists eq true; account_active eq true",
      "Post-Conditions Failure": "needs_human_support eq true",
      "Next Success": "core_check_credentials",
      "Next Failure": "support_escalate",
      "Notiz": "Zentrale Blocker-Regel."
    },
    {
      "Prio": 20,
      "Regel-ID": "core_check_credentials",
      "Anzeigename": "Zugangsdaten bekannt?",
      "Namespace": "core",
      "Regeltyp": "precondition_rule",
      "Status": "aktiv",
      "Pre-Conditions": "service in eduroam, vpn, mfa; account_exists eq true",
      "Trigger-Conditions": "username_known in false, unknown; password_known in false, unknown",
      "Action / Funktion": "core_credentials_help",
      "Action Anzeigename": "Zugangsdaten prüfen",
      "Post-Conditions Success": "username_known eq true; password_known eq true",
      "Post-Conditions Failure": "needs_human_support maybe true",
      "Next Success": "service_specific_chain",
      "Next Failure": "support_escalate",
      "Notiz": "Vor Login-/Setup-Regeln."
    },
    {
      "Prio": 25,
      "Regel-ID": "core_password_changed_router",
      "Anzeigename": "Passwortänderung beeinflusst Eduroam/VPN",
      "Namespace": "core",
      "Regeltyp": "troubleshooting_rule",
      "Status": "aktiv",
      "Pre-Conditions": "account_exists eq true; username_known eq true; password_known eq true",
      "Trigger-Conditions": "password_recently_changed eq true",
      "Action / Funktion": "core_password_change_router",
      "Action Anzeigename": "Folgen einer Passwortänderung prüfen",
      "Post-Conditions Success": "stored_credentials_may_be_invalid eq true",
      "Post-Conditions Failure": null,
      "Next Success": "affected_service_troubleshooting",
      "Next Failure": null,
      "Notiz": "Überschneidung zwischen Eduroam und VPN."
    },
    {
      "Prio": 30,
      "Regel-ID": "mfa_vpn_requirement",
      "Anzeigename": "MFA für VPN erforderlich",
      "Namespace": "service.mfa",
      "Regeltyp": "precondition_rule",
      "Status": "aktiv",
      "Pre-Conditions": "service eq vpn",
      "Trigger-Conditions": "mfa_required_for_vpn eq true",
