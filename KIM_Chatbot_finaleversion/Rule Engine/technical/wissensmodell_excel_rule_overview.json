{
  "source": "Regeln_vollständig_neu.xlsx",
  "items": [
    {
      "Prio": 5,
      "Regel-ID": "security_eduroam_certificate_warning",
      "Anzeigename": "Eduroam-Zertifikatswarnung priorisiert behandeln",
      "Namespace": "service.eduroam",
      "Regeltyp": "safety_rule",
      "Status": "aktiv",
      "Pre-Conditions": "service eq eduroam",
      "Trigger-Conditions": "eduroam_certificate_warning_shown eq true; problem_type eq certificate_warning",
      "Action / Funktion": "eduroam_troubleshoot_certificate_warning",
      "Action Anzeigename": "Eduroam-Zertifikatswarnung prüfen",
      "Post-Conditions Success": "eduroam_certificate_checked eq true; eduroam_profile_configured maybe false",
      "Post-Conditions Failure": "needs_human_support maybe true",
      "Next Success": "eduroam_profile_router",
      "Next Failure": "support_escalate",
      "Notiz": "Sicherheitsrelevant; Zertifikat nur für Eduroam."
    },
    {
      "Prio": 10,
      "Regel-ID": "core_route_topic",
      "Anzeigename": "Thema erkennen und Service-Kette starten",
      "Namespace": "core",
      "Regeltyp": "router_rule",
      "Status": "aktiv",
      "Pre-Conditions": null,
      "Trigger-Conditions": "service in eduroam, vpn, mfa, unknown",
      "Action / Funktion": "core_route_to_service",
      "Action Anzeigename": "Thema erkennen",
      "Post-Conditions Success": "service eq eduroam/vpn/mfa",
      "Post-Conditions Failure": null,
      "Next Success": "service_specific_chain",
      "Next Failure": "core_clarify_topic",
      "Notiz": "Einstieg in alle Abläufe."
    },
    {
