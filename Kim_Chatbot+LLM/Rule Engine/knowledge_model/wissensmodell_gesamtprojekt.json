{
  "id": "wissensmodell_gesamtprojekt_v2",
  "name": "Wissensmodell Gesamtprojekt v2 – fachliche und technische Sicht",
  "version": "2.0",
  "description": "Aus der aktualisierten fachlichen und technischen Wissensmodell-Grafik abgeleitete dienstübergreifende Wissensstruktur. Die technische Sicht nutzt Namespaces core.*, service.mfa.*, service.vpn.*, service.eduroam.* und service.support.*. Globale Bausteine bleiben erhalten und werden mit dienstspezifischen Pfaden kombiniert.",
  "source_images": [
    "knowledge_model/evidence/wissensmodell_fachliche_sicht_v2.jpeg",
    "knowledge_model/evidence/wissensmodell_technische_sicht_v2.jpeg"
  ],
  "color_blocks": [
    {
      "id": "grey",
      "name": "Gemeinsamer Wissenskern",
      "meaning": "Normale Abhängigkeiten und gemeinsame Fakten wie Account, Gerät, Netzwerk, Credentials, Auth-Status und Zielstatus."
    },
    {
      "id": "purple",
      "name": "Account & Zugangsdaten",
      "meaning": "Fakten und Pfade rund um Account, Benutzername, Passwort und Loginbasis."
    },
    {
      "id": "blue",
      "name": "Campus / Netzwerk / eduroam / VPN",
      "meaning": "Netzwerkkontext, Campus-WLAN, eduroam-Sichtbarkeit, VPN-Client und Verbindungsstatus."
    },
    {
      "id": "orange",
      "name": "MFA ↔ VPN",
      "meaning": "MFA-/TOTP-Code als Voraussetzung für VPN-Login. Hinweis: Kein Push-Verfahren; relevant ist der zeitbasierte Code aus der Authenticator-App."
    },
    {
      "id": "red",
      "name": "Fehlerbilder / Troubleshooting",
      "meaning": "Blockierende Fehlerpfade wie Account gesperrt, Passwortänderung, Clientproblem, Zertifikatswarnung oder ungelöster Status."
    }
  ],
  "namespaces": [
    {
      "id": "core",
      "label": "core.*",
      "description": "Gemeinsame Wissensbasis für alle Dienste."
    },
    {
      "id": "service.mfa",
      "label": "service.mfa.*",
      "description": "MFA-spezifische Zustände und Hilfefälle. In diesem Modell wird ein TOTP-Code genutzt, keine Push-Benachrichtigung."
    },
    {
      "id": "service.vpn",
      "label": "service.vpn.*",
      "description": "VPN-spezifische Zustände vom Client bis zum Tunnel und Ressourcenzugriff."
    },
    {
      "id": "service.eduroam",
      "label": "service.eduroam.*",
      "description": "eduroam-spezifische Zustände von Campus/WLAN-Sichtbarkeit über Profil/Zertifikat bis Internetzugriff."
    },
    {
      "id": "service.support",
      "label": "service.support.*",
      "description": "Support- und Eskalationsknoten."
    }
  ],
