[
  {
    "id": "core.topic.unknown",
    "active": true,
    "description": "Thema fehlt; Einstieg klären.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "unknown"
        }
      ]
    },
    "then": [
      {
        "type": "ask",
        "fact": "topic",
        "text": "Geht es um Benutzerkonto, eduroam, MFA oder VPN?"
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "core.intent.unknown",
    "active": true,
    "description": "Absicht fehlt; Ziel der Anfrage klären.",
    "when": {
      "all": [
        {
          "fact": "intent",
          "operator": "equals",
          "value": "unknown"
        }
      ]
    },
    "then": [
      {
        "type": "ask",
        "fact": "intent",
        "text": "Möchtest du etwas einrichten, ein Login-Problem lösen, dein Passwort ändern/zurücksetzen oder nur eine allgemeine Information?"
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "core.os.needed_for_setup",
    "active": true,
    "description": "Für technische Einrichtung wird das Betriebssystem benötigt.",
    "when": {
      "all": [
        {
          "fact": "intent",
          "operator": "equals",
          "value": "setup"
        },
        {
          "fact": "os",
          "operator": "equals",
          "value": "unknown"
        }
      ],
      "any": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "eduroam"
        },
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        },
        {
          "fact": "topic",
          "operator": "equals",
          "value": "mfa"
        }
      ]
    },
    "then": [
      {
        "type": "ask",
        "fact": "os",
        "text": "Welches Betriebssystem nutzt du: Windows, macOS, Linux, Android, iOS/iPadOS oder ChromeOS?"
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "core.account.status_needed",
    "active": true,
    "description": "Für KIM-Dienste wird meistens ein aktiviertes Benutzerkonto benötigt.",
    "when": {
      "all": [
        {
          "fact": "account_activated",
          "operator": "equals",
          "value": "unknown"
        }
      ],
      "any": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "eduroam"
        },
        {
          "fact": "topic",
          "operator": "equals",
          "value": "mfa"
        },
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        }
      ]
    },
    "then": [
      {
        "type": "ask",
        "fact": "account_activated",
        "text": "Ist dein Hohenheimer Benutzerkonto bereits aktiviert?"
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "core.vpn.kuerzel_needed",
    "active": true,
    "description": "Für VPN wird das Kürzel benötigt.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        },
        {
          "fact": "account_activated",
          "operator": "equals",
          "value": true
        },
        {
          "fact": "kuerzel_known",
          "operator": "equals",
          "value": "unknown"
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Für VPN brauchst du dein Kürzel bzw. deine Hohenheimer Benutzerkennung. Das ist nicht deine persönliche E-Mail-Adresse."
      },
      {
        "type": "ask",
        "fact": "kuerzel_known",
        "text": "Kennst du dein Kürzel bzw. deine Hohenheimer Benutzerkennung?"
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "core.identifier.explain_if_unknown",
    "active": true,
    "description": "Benutzername/Kürzel erklären, wenn das Format unklar ist.",
    "when": {
      "all": [
        {
          "fact": "identifier_entered_type",
          "operator": "equals",
          "value": "unknown"
        },
        {
          "fact": "identifier_usage_context",
          "operator": "not_equals",
          "value": "unknown"
        }
      ]
    },
    "then": [
      {
        "type": "show_steps",
        "step_package_id": "steps.account.explain_identifiers"
      }
    ],
    "stop_after_match": true
  }
]