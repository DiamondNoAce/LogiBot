  {
    "id": "vpn.problem.wrong_group",
    "active": true,
    "description": "Falsche VPN-Gruppe ausgewählt.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        },
        {
          "fact": "vpn_group_selected",
          "operator": "equals",
          "value": "other"
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Wähle für die VPN-Verbindung die Gruppe UHOH-2FA aus, damit das Feld für den zweiten Faktor angezeigt wird."
      },
      {
        "type": "set_fact",
        "fact": "vpn_group_selected",
        "value": "UHOH-2FA"
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "vpn.problem.linux_certificate",
    "active": true,
    "description": "Linux-Zertifikatsfehler beim VPN-Verbindungsaufbau.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        },
        {
          "fact": "os",
          "operator": "equals",
          "value": "linux"
        },
        {
          "fact": "linux_certificate_error",
          "operator": "equals",
          "value": true
        }
      ]
    },
    "then": [
      {
        "type": "show_steps",
        "step_package_id": "steps.vpn.linux_certificate_fix"
      },
      {
        "type": "set_fact",
        "fact": "troubleshooting_guidance_provided",
        "value": true
      }
    ],
    "stop_after_match": true
  }
]