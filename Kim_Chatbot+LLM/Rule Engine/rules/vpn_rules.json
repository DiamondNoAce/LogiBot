[
  {
    "id": "vpn.setup.no_account",
    "active": true,
    "description": "VPN braucht Benutzerkonto und Kürzel.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        },
        {
          "fact": "account_activated",
          "operator": "equals",
          "value": false
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Für VPN brauchst du zuerst ein aktiviertes Hohenheimer Benutzerkonto. Wichtig ist dabei dein Kürzel bzw. deine Hohenheimer Benutzerkennung."
      },
      {
        "type": "redirect_topic",
        "topic": "user_account",
        "intent": "setup",
        "text": "Bitte aktiviere zuerst dein Benutzerkonto."
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "vpn.problem.email_personal_used_as_username",
    "active": true,
    "description": "Persönliche E-Mail-Adresse wurde bei VPN als Benutzername genutzt.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        },
        {
          "fact": "identifier_entered_type",
          "operator": "equals",
          "value": "email_personal"
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Für VPN darf nicht die persönliche E-Mail-Adresse im Format vorname.nachname@uni-hohenheim.de verwendet werden. Trage nur dein Kürzel bzw. deine Hohenheimer Benutzerkennung ein."
      },
      {
        "type": "set_fact",
        "fact": "vpn_username_format_correct",
        "value": false
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "vpn.problem.email_kuerzel_domain_used_as_username",
    "active": true,
    "description": "kuerzel@uni-hohenheim.de wurde bei VPN als Benutzername genutzt.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        },
        {
          "fact": "identifier_entered_type",
          "operator": "equals",
          "value": "email_kuerzel_domain"
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Für VPN wird nicht kuerzel@uni-hohenheim.de verwendet. Dieses Format ist für eduroam relevant. Im VPN verwendest du nur dein Kürzel, z. B. mmuster."
      },
      {
        "type": "set_fact",
        "fact": "vpn_username_format_correct",
        "value": false
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "vpn.connect.mfa_missing",
    "active": true,
    "description": "VPN benötigt MFA, aber MFA fehlt.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        },
        {
          "fact": "mfa_configured",
          "operator": "equals",
          "value": false
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Für VPN wird ein zweiter Faktor benötigt. Richte zuerst MFA ein."
      },
      {
        "type": "redirect_topic",
        "topic": "mfa",
        "intent": "setup",
        "text": "Starte mit der MFA-Einrichtung."
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "vpn.connect.pc_with_mobile_2fa",
    "active": true,
    "description": "VPN am PC mit mobiler 2FA-App verwenden.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        },
        {
          "fact": "vpn_client_installed",
          "operator": "equals",
          "value": true
        },
        {
          "fact": "mfa_configured",
          "operator": "equals",
          "value": true
        },
        {
          "fact": "device_type",
          "operator": "in",
          "value": [
            "pc",
            "laptop"
          ]
        },
        {
          "fact": "second_factor_source",
          "operator": "equals",
          "value": "2fas_mobile_app"
        }
      ]
    },
    "then": [
      {
        "type": "show_steps",
        "step_package_id": "steps.vpn.pc_connect_with_mobile_2fa"
      },
      {
        "type": "set_fact",
        "fact": "setup_guidance_provided",
        "value": true
      }
    ],
    "stop_after_match": true
  },
