{
  "source": "Regeln_aus_Wissensmodell_nach_Eduroam_Struktur.xlsx",
  "items": [
    {
      "Prio": 5,
      "Regel-ID": "security_eduroam_certificate_warning",
      "Regeltyp": "safety_rule",
      "Pre-Conditions": "service = eduroam",
      "Trigger-Conditions": "eduroam_certificate_warning_shown = true; problem_type = certificate_warning",
      "Action / Funktion": "eduroam_troubleshoot_certificate_warning",
      "Post-Conditions": "eduroam_certificate_checked = true; eduroam_profile_configured ggf. false",
      "Next": "eduroam_profile_router",
      "Risiko / Notiz": "Sicherheitskritisch; nur Eduroam, keine Verbindung zum VPN-Zertifikat"
    },
    {
      "Prio": 10,
      "Regel-ID": "core_route_topic",
      "Regeltyp": "router_rule",
      "Pre-Conditions": null,
      "Trigger-Conditions": "service in eduroam, vpn, mfa, unknown",
      "Action / Funktion": "core_route_to_service",
      "Post-Conditions": "service = eduroam/vpn/mfa",
      "Next": "service_specific_chain",
      "Risiko / Notiz": "Muss vor service-spezifischen Regeln laufen"
    },
    {
      "Prio": 12,
      "Regel-ID": "core_check_guest_access",
      "Regeltyp": "precondition_rule",
      "Pre-Conditions": "user_role = guest",
      "Trigger-Conditions": "guest_access_exists in false, unknown",
      "Action / Funktion": "core_guest_access_help",
      "Post-Conditions": "needs_human_support ggf. true",
      "Next": "core_check_account_exists",
      "Risiko / Notiz": "Gäste ohne Zugang nicht in normale Account-/Setup-Kette schicken"
    },
    {
      "Prio": 15,
      "Regel-ID": "core_check_account_exists",
      "Regeltyp": "precondition_rule",
      "Pre-Conditions": "service in eduroam, vpn, mfa",
      "Trigger-Conditions": "account_exists in false, unknown",
      "Action / Funktion": "core_account_check",
      "Post-Conditions": "account_exists = true; needs_human_support bei Fehlschlag true",
      "Next": "core_check_credentials",
      "Risiko / Notiz": "Blocker: ohne Account keine normale Nutzung"
    },
    {
      "Prio": 20,
      "Regel-ID": "core_check_credentials",
      "Regeltyp": "precondition_rule",
      "Pre-Conditions": "service in eduroam, vpn, mfa; account_exists = true",
      "Trigger-Conditions": "username_known in false, unknown; password_known in false, unknown",
      "Action / Funktion": "core_credentials_help",
      "Post-Conditions": "username_known = true; password_known = true",
      "Next": "service_specific_chain",
      "Risiko / Notiz": "Zugangsdaten müssen vor Login-/Setup-Regeln geklärt sein"
    },
    {
      "Prio": 25,
      "Regel-ID": "core_password_changed_router",
      "Regeltyp": "troubleshooting_rule",
      "Pre-Conditions": "account_exists = true; username_known = true; password_known = true",
      "Trigger-Conditions": "password_recently_changed = true",
      "Action / Funktion": "core_password_change_router",
      "Post-Conditions": "stored_credentials_may_be_invalid = true",
      "Next": "eduroam_profile_router oder vpn_auth_problem",
      "Risiko / Notiz": "Passwortänderung kann Eduroam und VPN beeinflussen"
    },
    {
      "Prio": 30,
      "Regel-ID": "mfa_vpn_requirement",
      "Regeltyp": "precondition_rule",
      "Pre-Conditions": "service = vpn",
      "Trigger-Conditions": "mfa_required_for_vpn = true",
      "Action / Funktion": "mfa_requirement_info",
      "Post-Conditions": "vpn_mfa_required = true",
      "Next": "mfa_check_enrollment",
      "Risiko / Notiz": "MFA ist für VPN immer notwendig"
    },
    {
      "Prio": 35,
      "Regel-ID": "mfa_check_enrollment",
      "Regeltyp": "precondition_rule",
      "Pre-Conditions": "account_exists = true; username_known = true; password_known = true",
      "Trigger-Conditions": "mfa_enrolled in false, unknown",
      "Action / Funktion": "mfa_setup_authenticator",
      "Post-Conditions": "mfa_enrolled = true; mfa_totp_available = true",
      "Next": "mfa_check_totp_code",
      "Risiko / Notiz": "MFA-Erstinstallation benötigt Account und Zugangsdaten"
    },
    {
      "Prio": 38,
      "Regel-ID": "mfa_check_totp_code",
      "Regeltyp": "auth_rule",
      "Pre-Conditions": "mfa_enrolled = true; mfa_totp_available = true",
      "Trigger-Conditions": "mfa_code_status in not_tested, invalid, expired",
      "Action / Funktion": "mfa_validate_totp_code",
      "Post-Conditions": "mfa_code_status = valid",
      "Next": "vpn_authenticate",
      "Risiko / Notiz": "Kein Push; App-Code läuft alle 30 Sekunden ab"
    },
    {
      "Prio": 40,
      "Regel-ID": "eduroam_check_campus_context",
      "Regeltyp": "precondition_rule",
      "Pre-Conditions": "service = eduroam",
      "Trigger-Conditions": "on_campus in false, unknown",
      "Action / Funktion": "eduroam_campus_location_help",
      "Post-Conditions": "on_campus = true",
      "Next": "eduroam_check_wifi_available",
      "Risiko / Notiz": "Eduroam-Sichtbarkeit/Nutzung ist standortbezogen"
    },
    {
      "Prio": 42,
      "Regel-ID": "eduroam_check_wifi_available",
      "Regeltyp": "precondition_rule",
      "Pre-Conditions": "service = eduroam; on_campus = true",
      "Trigger-Conditions": "wifi_available in false, unknown",
      "Action / Funktion": "eduroam_wifi_hardware_check",
      "Post-Conditions": "wifi_available = true",
      "Next": "eduroam_check_wifi_enabled",
      "Risiko / Notiz": "Gerät braucht WLAN"
    },
    {
      "Prio": 45,
      "Regel-ID": "eduroam_check_wifi_enabled",
      "Regeltyp": "precondition_rule",
      "Pre-Conditions": "service = eduroam; wifi_available = true",
      "Trigger-Conditions": "wifi_enabled in false, unknown",
      "Action / Funktion": "eduroam_enable_wifi",
      "Post-Conditions": "wifi_enabled = true",
      "Next": "eduroam_check_visible_network",
      "Risiko / Notiz": "Vor SSID-Suche ausführen"
    },
    {
      "Prio": 50,
      "Regel-ID": "eduroam_check_visible_network",
      "Regeltyp": "precondition_rule",
      "Pre-Conditions": "service = eduroam; on_campus = true; wifi_enabled = true",
      "Trigger-Conditions": "eduroam_visible in false, unknown",
      "Action / Funktion": "eduroam_troubleshoot_not_visible",
      "Post-Conditions": "eduroam_visible = true; needs_human_support bei Fehlschlag true",
      "Next": "eduroam_profile_router",
      "Risiko / Notiz": "Vor Profil-Setup prüfen"
    },
    {
      "Prio": 60,
      "Regel-ID": "eduroam_profile_router",
      "Regeltyp": "router_rule",
      "Pre-Conditions": "service = eduroam; account_exists = true; username_known = true; password_known = true; eduroam_visible = true",
      "Trigger-Conditions": "eduroam_profile_configured in false, unknown",
      "Action / Funktion": "eduroam_setup_router",
      "Post-Conditions": "operating_system wird gesetzt windows/macos/ios/android/linux",
      "Next": "eduroam_setup_os_specific",
      "Risiko / Notiz": "Router darf OS-spezifische Regeln nicht überschreiben"
    },
    {
      "Prio": 61,
      "Regel-ID": "eduroam_setup_windows",
      "Regeltyp": "setup_rule",
      "Pre-Conditions": "service = eduroam; account_exists = true; username_known = true; password_known = true; eduroam_visible = true; operating_system = windows",
      "Trigger-Conditions": "eduroam_profile_configured in false, unknown",
      "Action / Funktion": "eduroam_setup_windows",
      "Post-Conditions": "eduroam_profile_configured = true; eduroam_connection_status = not_tested",
      "Next": "eduroam_connection_attempt",
      "Risiko / Notiz": "Spezifische Setup-Regel"
    },
    {
      "Prio": 62,
      "Regel-ID": "eduroam_setup_macos",
      "Regeltyp": "setup_rule",
      "Pre-Conditions": "service = eduroam; account_exists = true; username_known = true; password_known = true; eduroam_visible = true; operating_system = macos",
      "Trigger-Conditions": "eduroam_profile_configured in false, unknown",
      "Action / Funktion": "eduroam_setup_macos",
      "Post-Conditions": "eduroam_profile_configured = true; eduroam_connection_status = not_tested",
      "Next": "eduroam_connection_attempt",
      "Risiko / Notiz": "Spezifische Setup-Regel"
    },
    {
      "Prio": 63,
      "Regel-ID": "eduroam_setup_ios",
      "Regeltyp": "setup_rule",
      "Pre-Conditions": "service = eduroam; account_exists = true; username_known = true; password_known = true; eduroam_visible = true; operating_system = ios",
      "Trigger-Conditions": "eduroam_profile_configured in false, unknown",
      "Action / Funktion": "eduroam_setup_ios",
      "Post-Conditions": "eduroam_profile_configured = true; eduroam_connection_status = not_tested",
      "Next": "eduroam_connection_attempt",
      "Risiko / Notiz": "Spezifische Setup-Regel"
    },
    {
      "Prio": 64,
      "Regel-ID": "eduroam_setup_android",
      "Regeltyp": "setup_rule",
      "Pre-Conditions": "service = eduroam; account_exists = true; username_known = true; password_known = true; eduroam_visible = true; operating_system = android",
      "Trigger-Conditions": "eduroam_profile_configured in false, unknown",
      "Action / Funktion": "eduroam_setup_android",
      "Post-Conditions": "eduroam_profile_configured = true; eduroam_connection_status = not_tested",
      "Next": "eduroam_connection_attempt",
      "Risiko / Notiz": "Spezifische Setup-Regel"
    },
    {
      "Prio": 65,
      "Regel-ID": "eduroam_setup_linux",
      "Regeltyp": "setup_rule",
      "Pre-Conditions": "service = eduroam; account_exists = true; username_known = true; password_known = true; eduroam_visible = true; operating_system = linux",
      "Trigger-Conditions": "eduroam_profile_configured in false, unknown",
      "Action / Funktion": "eduroam_setup_linux",
      "Post-Conditions": "eduroam_profile_configured = true; eduroam_connection_status = not_tested",
      "Next": "eduroam_connection_attempt",
      "Risiko / Notiz": "Spezifische Setup-Regel"
    },
    {
      "Prio": 80,
      "Regel-ID": "eduroam_connection_attempt",
      "Regeltyp": "connection_rule",
      "Pre-Conditions": "service = eduroam; eduroam_profile_configured = true; username_known = true; password_known = true",
      "Trigger-Conditions": "eduroam_connection_status in not_tested, failed",
      "Action / Funktion": "eduroam_try_connect",
      "Post-Conditions": "eduroam_connection_status = connected oder failed",
      "Next": "eduroam_check_internet",
      "Risiko / Notiz": "Setup endet nie ohne Verbindungstest"
    },
    {
      "Prio": 90,
      "Regel-ID": "eduroam_connection_failed",
      "Regeltyp": "troubleshooting_rule",
      "Pre-Conditions": "service = eduroam; eduroam_profile_configured = true; eduroam_connection_status = failed",
      "Trigger-Conditions": "problem_type in auth_failed, unknown",
      "Action / Funktion": "eduroam_troubleshoot_auth_or_password",
      "Post-Conditions": "credentials_checked = true; profile_recreation_required ggf. true",
      "Next": "eduroam_recreate_profile_or_retry",
      "Risiko / Notiz": "Prüft Zugangsdaten/Profile"
    },
    {
      "Prio": 100,
      "Regel-ID": "eduroam_check_internet",
      "Regeltyp": "connection_rule",
      "Pre-Conditions": "service = eduroam; eduroam_connection_status = connected",
      "Trigger-Conditions": "eduroam_internet_access in false, unknown",
      "Action / Funktion": "eduroam_troubleshoot_no_internet",
      "Post-Conditions": "eduroam_internet_access = true; needs_human_support bei Fehlschlag true",
      "Next": "finish_resolved",
      "Risiko / Notiz": "No-Internet nicht mit Loginfehler vermischen"
    },
    {
      "Prio": 110,
      "Regel-ID": "eduroam_connection_drops",
      "Regeltyp": "troubleshooting_rule",
      "Pre-Conditions": "service = eduroam; eduroam_profile_configured = true",
      "Trigger-Conditions": "problem_type = connection_drops",
      "Action / Funktion": "eduroam_troubleshoot_connection_drops",
      "Post-Conditions": "eduroam_connection_status = not_tested",
      "Next": "eduroam_connection_attempt",
      "Risiko / Notiz": "Standort/Neustart/Profil erneuern"
    },
    {
      "Prio": 120,
      "Regel-ID": "vpn_check_installation_campus_network",
      "Regeltyp": "precondition_rule",
      "Pre-Conditions": "service = vpn; vpn_client_installed in false, unknown",
      "Trigger-Conditions": "on_campus in false, unknown; campus_wifi_available = false; campus_lan_available = false",
      "Action / Funktion": "vpn_campus_network_help",
      "Post-Conditions": "vpn_installation_allowed = true",
      "Next": "vpn_install_client",
      "Risiko / Notiz": "VPN-Erstinstallation am Campus über Eduroam-WLAN oder LAN"
    },
    {
      "Prio": 125,
      "Regel-ID": "vpn_install_client",
      "Regeltyp": "setup_rule",
      "Pre-Conditions": "service = vpn; account_exists = true; username_known = true; password_known = true; on_campus = true",
      "Trigger-Conditions": "vpn_client_installed in false, unknown",
      "Action / Funktion": "vpn_install_client_os_specific",
      "Post-Conditions": "vpn_client_installed = true; vpn_installation_status = installed",
      "Next": "vpn_check_client_healthy",
      "Risiko / Notiz": "OS-spezifische VPN-Installation"
    },
    {
      "Prio": 130,
      "Regel-ID": "vpn_check_client_healthy",
      "Regeltyp": "precondition_rule",
      "Pre-Conditions": "service = vpn; vpn_client_installed = true",
      "Trigger-Conditions": "vpn_client_healthy in false, unknown",
      "Action / Funktion": "vpn_check_client_health",
      "Post-Conditions": "vpn_client_healthy = true",
      "Next": "vpn_profile_router",
      "Risiko / Notiz": "Nach Installation können trotzdem Client-Probleme auftreten"
    },
    {
      "Prio": 135,
      "Regel-ID": "vpn_profile_router",
      "Regeltyp": "router_rule",
      "Pre-Conditions": "service = vpn; vpn_client_installed = true; vpn_client_healthy = true",
      "Trigger-Conditions": "vpn_profile_configured in false, unknown",
      "Action / Funktion": "vpn_configure_profile_gateway",
      "Post-Conditions": "vpn_profile_configured = true",
      "Next": "mfa_vpn_requirement",
      "Risiko / Notiz": "Profil/Gateway vor Authentifizierung"
    },
    {
      "Prio": 140,
      "Regel-ID": "vpn_authenticate",
      "Regeltyp": "auth_rule",
      "Pre-Conditions": "service = vpn; vpn_profile_configured = true; account_exists = true; username_known = true; password_known = true; mfa_code_status = valid",
      "Trigger-Conditions": "vpn_auth_status in not_tested, failed",
      "Action / Funktion": "vpn_authenticate_with_mfa",
      "Post-Conditions": "vpn_auth_status = success oder failed",
      "Next": "vpn_tunnel_attempt",
      "Risiko / Notiz": "VPN-Login benötigt MFA-Code"
    },
    {
      "Prio": 145,
      "Regel-ID": "vpn_tunnel_attempt",
      "Regeltyp": "connection_rule",
      "Pre-Conditions": "service = vpn; vpn_auth_status = success",
      "Trigger-Conditions": "vpn_tunnel_status in not_tested, failed",
      "Action / Funktion": "vpn_connect_tunnel",
      "Post-Conditions": "vpn_tunnel_status = connected oder failed",
      "Next": "vpn_check_resource_access",
      "Risiko / Notiz": "Tunnelstatus separat vom Auth-Status prüfen"
    },
    {
      "Prio": 150,
      "Regel-ID": "vpn_check_resource_access",
      "Regeltyp": "connection_rule",
      "Pre-Conditions": "service = vpn; vpn_tunnel_status = connected",
      "Trigger-Conditions": "vpn_resource_accessible in false, unknown",
      "Action / Funktion": "vpn_check_internal_resources",
      "Post-Conditions": "vpn_resource_accessible = true",
      "Next": "finish_resolved",
      "Risiko / Notiz": "VPN verbunden heißt nicht automatisch Ressource erreichbar"
    },
    {
      "Prio": 155,
      "Regel-ID": "vpn_troubleshoot_installation",
      "Regeltyp": "troubleshooting_rule",
      "Pre-Conditions": "service = vpn",
      "Trigger-Conditions": "problem_type = install_failed; vpn_installation_status = failed",
      "Action / Funktion": "vpn_troubleshoot_installation",
      "Post-Conditions": "vpn_client_installed ggf. true",
      "Next": "vpn_check_client_healthy",
      "Risiko / Notiz": "Installationsproblem getrennt von Loginproblem behandeln"
    },
    {
      "Prio": 160,
      "Regel-ID": "vpn_troubleshoot_auth_mfa",
      "Regeltyp": "troubleshooting_rule",
      "Pre-Conditions": "service = vpn",
      "Trigger-Conditions": "problem_type in auth_failed, mfa_failed; vpn_auth_status = failed",
      "Action / Funktion": "vpn_troubleshoot_auth_mfa",
      "Post-Conditions": "credentials_checked = true; mfa_code_status ggf. not_tested",
      "Next": "mfa_check_totp_code",
      "Risiko / Notiz": "Trennt Zugangsdaten- und MFA-Fehler"
    },
    {
      "Prio": 165,
      "Regel-ID": "vpn_troubleshoot_tunnel_network",
      "Regeltyp": "troubleshooting_rule",
      "Pre-Conditions": "service = vpn; vpn_auth_status = success",
      "Trigger-Conditions": "problem_type in timeout, client_error; vpn_tunnel_status = failed",
      "Action / Funktion": "vpn_troubleshoot_tunnel_network",
      "Post-Conditions": "vpn_tunnel_status = not_tested",
      "Next": "vpn_tunnel_attempt",
      "Risiko / Notiz": "Nach erfolgreichem Login Tunnel/Netz separat prüfen"
    },
    {
      "Prio": 180,
      "Regel-ID": "finish_resolved",
      "Regeltyp": "completion_rule",
      "Pre-Conditions": "user_problem_resolved in true, unknown",
      "Trigger-Conditions": "eduroam_internet_access = true; vpn_resource_accessible = true",
      "Action / Funktion": "finish_resolved_response",
      "Post-Conditions": "user_problem_resolved = true; user_request_answered = true",
      "Next": "end",
      "Risiko / Notiz": "Finaler Zielzustand"
    },
    {
      "Prio": 190,
      "Regel-ID": "support_escalate",
      "Regeltyp": "escalation_rule",
      "Pre-Conditions": null,
      "Trigger-Conditions": "needs_human_support = true; user_problem_resolved in false, unknown",
      "Action / Funktion": "support_escalation_response",
      "Post-Conditions": "user_request_answered = true",
      "Next": "end",
      "Risiko / Notiz": "Abschluss erlaubt, wenn Supportweg ausgegeben wurde"
    },
    {
      "Prio": 999,
      "Regel-ID": "service_fallback",
      "Regeltyp": "fallback_rule",
      "Pre-Conditions": "service in eduroam, vpn, mfa, unknown",
      "Trigger-Conditions": "no_specific_rule_matches = true",
      "Action / Funktion": "core_clarify_missing_facts",
      "Post-Conditions": "missing_facts werden abgefragt true",
      "Next": "service_specific_chain",
      "Risiko / Notiz": "Ganz unten, sonst Überschattung"
    }
  ]
}