    "then": [
      {
        "type": "answer",
        "text": "Wenn du dein aktuelles Passwort kennst, kannst du es im IDM ändern. Danach müssen gespeicherte Passwörter in eduroam, E-Mail-Programmen, Browsern oder Netzlaufwerken ggf. aktualisiert werden."
      }
    ],
    "stop_after_match": true,
    "source_file": "Rules/user_account_rules"
  },
  {
