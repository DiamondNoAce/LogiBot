      {
        "type": "show_steps",
        "step_package_id": "steps.account.activate_student_account"
      }
    ],
    "stop_after_match": true,
    "source_file": "Rules/user_account_rules"
  },
  {
    "id": "account.setup.activation_code_missing",
    "module": "account",
    "rule_group": "user_account",
    "description": "Aktivierungscode fehlt.",
    "active": true,
    "priority": 20003,
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
