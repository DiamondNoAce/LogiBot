[
  {
    "id": "core.topic.unknown",
    "module": "core",
    "rule_group": "core_router",
    "description": "Thema fehlt; Einstieg klären.",
    "active": true,
    "priority": 10001,
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "unknown"
        }
      ]
    },
    "then": [
      {
        "type": "ask",
        "fact": "topic",
        "text": "Geht es um Benutzerkonto, eduroam, MFA oder VPN?"
      }
    ],
    "stop_after_match": true,
    "source_file": "Rules/core_router_rules"
  },
  {
    "id": "core.intent.unknown",
    "module": "core",
    "rule_group": "core_router",
    "description": "Absicht fehlt; Ziel der Anfrage klären.",
    "active": true,
    "priority": 10002,
    "when": {
      "all": [
        {
          "fact": "intent",
          "operator": "equals",
          "value": "unknown"
        }
      ]
    },
    "then": [
      {
        "type": "ask",
        "fact": "intent",
        "text": "Möchtest du etwas einrichten, ein Login-Problem lösen, dein Passwort ändern/zurücksetzen oder nur eine allgemeine Information?"
      }
    ],
    "stop_after_match": true,
    "source_file": "Rules/core_router_rules"
  },
  {
    "id": "core.os.needed_for_setup",
    "module": "core",
    "rule_group": "core_router",
    "description": "Für technische Einrichtung wird das Betriebssystem benötigt.",
    "active": true,
    "priority": 10003,
    "when": {
      "all": [
        {
          "fact": "intent",
          "operator": "equals",
          "value": "setup"
        },
        {
          "fact": "os",
          "operator": "equals",
          "value": "unknown"
        }
      ],
      "any": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "eduroam"
        },
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        },
        {
          "fact": "topic",
          "operator": "equals",
          "value": "mfa"
        }
      ]
    },
    "then": [
      {
        "type": "ask",
        "fact": "os",
        "text": "Welches Betriebssystem nutzt du: Windows, macOS, Linux, Android, iOS/iPadOS oder ChromeOS?"
      }
    ],
    "stop_after_match": true,
    "source_file": "Rules/core_router_rules"
  },
  {
    "id": "core.account.status_needed",
    "module": "core",
    "rule_group": "core_router",
    "description": "Für KIM-Dienste wird meistens ein aktiviertes Benutzerkonto benötigt.",
    "active": true,
    "priority": 10004,
    "when": {
      "all": [
        {
          "fact": "account_activated",
          "operator": "equals",
          "value": "unknown"
        }
      ],
      "any": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "eduroam"
        },
        {
          "fact": "topic",
          "operator": "equals",
          "value": "mfa"
        },
        {
          "fact": "topic",
          "operator": "equals",
          "value": "vpn"
        }
      ]
    },
    "then": [
      {
        "type": "ask",
        "fact": "account_activated",
        "text": "Ist dein Hohenheimer Benutzerkonto bereits aktiviert?"
      }
    ],
    "stop_after_match": true,
    "source_file": "Rules/core_router_rules"
  },
  {
    "id": "account.info.required_for_services",
    "module": "account",
    "rule_group": "user_account",
    "description": "Allgemeine Erklärung zum Hohenheimer Benutzerkonto.",
    "active": true,
    "priority": 20001,
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "user_account"
        },
        {
          "fact": "intent",
          "operator": "equals",
          "value": "information"
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Das Hohenheimer Benutzerkonto ist die zentrale Voraussetzung für viele digitale Dienste wie E-Mail, ILIAS, HohCampus, Bibliothekskonto, eduroam und VPN."
      }
    ],
    "stop_after_match": true,
    "source_file": "Rules/user_account_rules"
  },
  {
    "id": "account.setup.student_not_activated",
    "module": "account",
    "rule_group": "user_account",
    "description": "Studierender hat Konto noch nicht aktiviert.",
    "active": true,
    "priority": 20002,
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "user_account"
        },
        {
          "fact": "role",
          "operator": "equals",
          "value": "student"
        },
        {
          "fact": "account_activated",
          "operator": "equals",
          "value": false
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Dein Hohenheimer Benutzerkonto wurde im Rahmen der Einschreibung vorbereitet und muss im IDM aktiviert werden."
