          "operator": "equals",
          "value": false
        },
        {
          "fact": "activation_code_available",
          "operator": "equals",
          "value": false
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Wenn du das Bewerbungsverfahren in HohCampus durchlaufen hast, entspricht der Aktivierungscode der Benutzerkennung aus dem HohCampus-Bewerbungsportal."
      },
      {
        "type": "support_contact",
        "topic": "account",
        "text": "Wenn du den Code nicht findest oder der Antrag schon länger als 2–3 Werktage zurückliegt, kontaktiere kim-it-account@uni-hohenheim.de."
      }
    ],
    "stop_after_match": true,
    "source_file": "Rules/user_account_rules"
  },
  {
