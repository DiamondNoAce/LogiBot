  {
    "id": "account.password.change_requested",
    "module": "account",
    "rule_group": "user_account",
    "description": "Nutzer möchte Passwort ändern.",
    "active": true,
    "priority": 20006,
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "user_account"
        },
