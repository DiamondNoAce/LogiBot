[
  {
    "id": "fallback.problem_unresolved",
    "active": true,
    "description": "Standardlösungen haben nicht geholfen.",
    "when": {
      "all": [
        {
          "fact": "problem_unresolved",
          "operator": "equals",
          "value": true
        },
        {
          "fact": "user_request_answered",
          "operator": "not_equals",
          "value": true
        }
      ]
    },
    "then": [
      {
        "type": "support_contact",
        "topic": "unknown",
        "text": "Wenn das Problem nach Setup und Problembehebung weiterhin besteht, wende dich an den KIM IT-Service-Desk."
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "fallback.no_rule_matched",
    "active": true,
    "description": "Keine Regel passt eindeutig.",
    "when": {
      "all": [
        {
          "fact": "no_rule_matched",
          "operator": "equals",
          "value": true
        }
      ]
    },
    "then": [
      {
        "type": "ask",
        "fact": "intent",
        "text": "Möchtest du etwas einrichten, ein Login-Problem lösen oder nur eine allgemeine Information?"
      }
    ],
    "stop_after_match": true
  }
]