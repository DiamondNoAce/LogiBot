        },
        {
          "fact": "os",
          "operator": "equals",
          "value": "windows"
        }
      ]
    },
    "then": [
      {
        "type": "show_steps",
        "step_package_id": "steps.eduroam.windows_cat"
      },
      {
        "type": "set_fact",
        "fact": "setup_guidance_provided",
        "value": true
      }
    ],
    "stop_after_match": true
  },
