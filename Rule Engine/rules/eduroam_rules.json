[
  {
    "id": "eduroam.setup.no_account",
    "active": true,
    "description": "eduroam braucht Benutzerkonto.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "eduroam"
        },
        {
          "fact": "account_activated",
          "operator": "equals",
          "value": false
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Für eduroam brauchst du zuerst ein aktiviertes Hohenheimer Benutzerkonto."
      },
      {
        "type": "redirect_topic",
        "topic": "user_account",
        "intent": "setup",
        "text": "Starte zuerst mit der Aktivierung des Benutzerkontos."
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "eduroam.problem.email_personal_used",
    "active": true,
    "description": "Persönliche Mailadresse wurde als eduroam-Benutzername genutzt.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "eduroam"
        },
        {
          "fact": "identifier_entered_type",
          "operator": "equals",
          "value": "email_personal"
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Für eduroam darf nicht die persönliche E-Mail-Adresse im Format vorname.nachname@uni-hohenheim.de verwendet werden. Nutze kuerzel@uni-hohenheim.de als technische eduroam-Identität."
      },
      {
        "type": "set_fact",
        "fact": "username_format_correct",
        "value": false
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "eduroam.problem.only_kuerzel_used",
    "active": true,
    "description": "Nur Kürzel statt kuerzel@uni-hohenheim.de genutzt.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "eduroam"
        },
        {
          "fact": "identifier_entered_type",
          "operator": "equals",
          "value": "kuerzel"
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Für eduroam reicht das reine Kürzel nicht aus. Verwende kuerzel@uni-hohenheim.de, z. B. mmuster@uni-hohenheim.de."
      },
      {
        "type": "set_fact",
        "fact": "username_format_correct",
        "value": false
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "eduroam.setup.no_internet",
    "active": true,
    "description": "Für eduroam-Einrichtung fehlt Internet.",
    "when": {
      "all": [
        {
          "fact": "topic",
          "operator": "equals",
          "value": "eduroam"
        },
        {
          "fact": "intent",
          "operator": "equals",
          "value": "setup"
        },
        {
          "fact": "internet_available",
          "operator": "equals",
          "value": false
        }
      ]
    },
    "then": [
      {
        "type": "answer",
        "text": "Für die eduroam-Ersteinrichtung brauchst du zunächst eine Internetverbindung."
      },
      {
        "type": "recommend",
        "text": "Nutze z. B. mobile Daten, Ethernet oder im IT-Service-Desk das Konfigurationsnetz, falls verfügbar."
      }
    ],
    "stop_after_match": true
  },
  {
    "id": "eduroam.setup.windows",
    "active": true,
    "description": "eduroam unter windows einrichten.",
