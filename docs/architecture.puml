@startuml
' Systemarchitektur LogiBot - Komponentendiagramm (PlantUML)
' Erzeugt: 2026-06-21
skinparam componentStyle rectangle

!define AWSPUML https://raw.githubusercontent.com/awslabs/aws-icons-for-plantuml/v14.0/LATEST/AWSPUML

package "Browser / User" {
  [Browser] as Browser
}

package "Streamlit App" {
  [Streamlit App\n(app.py)] as StreamlitApp
  [UI\n(ui/*.py)] as UI
  [Dialog Manager\n(dialog_manager.py)] as DialogManager
  [Inference Engine\n(inference_engine.py)] as InferenceEngine
  [Rule Engine Executor\n(rule_engine.py)] as RuleEngineExecutor
  [Decision Graph Engine\n(decision_graph_engine.py)] as DecisionGraph
  [LLM Adapter\n(ollama_client.py)] as LLMAdapter
  [Fact Extraction\n(fact_extraction.py)] as FactExtraction
  [Response Generation\n(response_generation.py)] as RespGen
  [Storage Layer\n(kb_loader/writer/validator/backups)] as StorageLayer
  [Rule Engine JSON\n(Rule Engine/)] as RuleEngineJSON
}

package "Optional API" {
  [Optional API\n(FastAPI)] as OptionalAPI
}

package "Infrastruktur" {
  [Reverse Proxy / TLS\n(nginx)] as NGINX
  [Container Host\n(Docker / Kubernetes)] as ContainerHost
  [Object Storage / S3\n(Backups)] as ObjectStorage
  [Monitoring\n(Prometheus / Grafana)] as Monitoring
  [Logging / Audit-Logs] as Logging
}

' Beziehungen / Datenfluss
Browser --> StreamlitApp : HTTP
StreamlitApp --> UI
UI --> DialogManager
DialogManager --> FactExtraction
FactExtraction --> DialogManager
DialogManager --> InferenceEngine
InferenceEngine --> RuleEngineExecutor
RuleEngineExecutor --> RuleEngineJSON
InferenceEngine --> DecisionGraph
DialogManager --> LLMAdapter
LLMAdapter --> RespGen
RespGen --> UI
DialogManager --> StorageLayer
StorageLayer --> RuleEngineJSON

' Optionaler API-Pfad (Entkopplung)
StreamlitApp --> OptionalAPI : Optional: HTTP
OptionalAPI --> DialogManager

' Infrastruktur-Verbindungen
NGINX --> StreamlitApp
NGINX --> OptionalAPI
StreamlitApp --> ContainerHost
OptionalAPI --> ContainerHost
StorageLayer --> ObjectStorage
ContainerHost --> Monitoring
ContainerHost --> Logging
LLMAdapter --> ObjectStorage : optional model storage
LLMAdapter --> [Ollama (lokal)]
LLMAdapter --> [Remote LLM API]

' Legende
note right of StreamlitApp
  Komponenten: UI, Orchestrierung (Dialog Manager),
  Core-Services (Inference, Rule Engine, Decision Graph),
  LLM-Integration, Storage
end note

note bottom
  Dieses Diagramm ist als Komponenten/UML-Darstellung gedacht.
  Datei: docs/architecture.puml
end note

@enduml
